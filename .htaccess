# Ansaaru Sunna Academy website: every address is drawn by index.php from the content published in the portal.
DirectoryIndex index.php
Options -Indexes
<IfModule mod_rewrite.c>
RewriteEngine On
# keep these folders and the settings file private
RewriteRule ^(cache|lib)(/|$) - [F,L]
RewriteRule ^config(\.sample)?\.php$ - [F,L]
# old .html pages, the sitemap and robots.txt always go through index.php (it moves .html addresses to the new ones)
RewriteRule ^(.+\.html?|index\.html?|sitemap\.xml|robots\.txt)$ index.php [L]
# pictures, PDFs, styles and scripts are served as they are; everything else is a page
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
</IfModule>
<IfModule mod_headers.c>
<FilesMatch "\.(woff2|jpe?g|png|webp|svg|ico)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
<FilesMatch "\.(css|js)$">
Header set Cache-Control "public, max-age=86400"
</FilesMatch>
</IfModule>
